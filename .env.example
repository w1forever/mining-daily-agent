# ============ 矿权日报 Agent 环境配置示例 ============
# 复制为 .env 后按需修改。切勿将含真实密钥的 .env 提交或写入镜像。

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- LLM（OpenAI 兼容协议，默认指向阿里云 DashScope 兼容端点）----
# 支持任意 OpenAI 兼容服务：设置 LLM_BASE_URL 与 LLM_MODEL 即可。
LLM_PROVIDER=openai_compatible          # openai_compatible | anthropic | mock
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=                            # 必填；不填时 /report 会返回 MODEL_CONFIG_MISSING
# VLM（PDF 复杂表格兜底，openai 兼容多模态模型）
VLM_MODEL=qwen-vl-plus
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=                            # 为空时复用 LLM_API_KEY
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0

# ---- Agent 任务预算 ----
TASK_TIMEOUT_SECONDS=600
MAX_RETRIES_TOOL=2
MAX_RETRIES_AGENT=1
MAX_REPORT_REVISIONS=1

# ---- MCP Server 连接（Docker 部署时使用服务名；本地 stdio 模式无需配置）----
MCP_TRANSPORT=http                        # http | stdio
MCP_NEWS_URL=http://mining-news-mcp:8001/mcp
MCP_PDF_URL=http://mineral-pdf-mcp:8002/mcp
MCP_PRICE_URL=http://lme-price-mcp:8003/mcp
MCP_CALL_TIMEOUT_SECONDS=60

# ---- HTTP 通用限制 ----
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=30
MAX_ARTICLE_BYTES=2097152                 # 2 MiB 正文抓取上限
MAX_DOWNLOAD_BYTES=52428800               # 50 MiB PDF 下载上限

# ---- PDF ----
PDF_MAX_PAGES=800
PDF_MAX_PARSE_SECONDS=120
PDF_USE_VLM=true                          # 复杂表格时启用 VLM 兜底（需要 VLM_API_KEY）
PDF_CACHE_DIR=data/cache/pdf
EXTRACT_CACHE_DIR=data/cache/extract

# ---- 新闻 ----
NEWS_CACHE_DIR=data/cache/news
NEWS_FETCH_TIMEOUT_SECONDS=20
NEWS_MAX_ITEMS=30

# ---- 价格 ----
PRICE_CACHE_DIR=data/cache/price
PRICE_CACHE_TTL_HOURS=6
FRED_ENABLED=true
SINA_GFEX_ENABLED=true

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- 报告输出 ----
REPORTS_DIR=reports
